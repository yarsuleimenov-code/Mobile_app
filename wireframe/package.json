{
  "name": "zaberman-wireframe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm build:app && pnpm docs:build",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "docs:prepare": "node scripts/prepare-docs.mjs",
    "docs:dev": "pnpm docs:prepare && vitepress dev docs-site",
    "docs:build": "pnpm docs:prepare && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site --port 4174",
    "pages:verify": "node scripts/verify-pages-artifact.mjs"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitepress": "1.6.4",
    "vitest": "^3.2.4"
  }
}
